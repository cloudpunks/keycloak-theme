{
  "$schema": "https://json.schemastore.org/package",
  "name": "theme",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "keycloakify sync-extensions",
    "dev": "vite",
    "storybook": "storybook dev -p 6006",
    "build": "tsc -b && vite build",
    "build-keycloak": "npm run build && keycloakify build",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deps": "ncu --upgrade",
    "clean": "rimraf dist/ dist_keycloak/ storybook-static/"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.10",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/lora": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource-variable/playfair-display": "^5.2.8",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@keycloakify/email-native": "~260007.0.0",
    "@keycloakify/login-ui": "~250004.7.0",
    "@oussemasahbeni/keycloakify-login-shadcn": "^250004.0.24",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "keycloakify": "^11.16.0",
    "lucide-react": "^1.16.0",
    "radix-ui": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.6.0",
    "rfc4648": "^1.5.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsafe": "^1.8.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "npm-check-updates": "23.1.0",
    "rimraf": "6.1.3",
    "storybook": "10.6.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
